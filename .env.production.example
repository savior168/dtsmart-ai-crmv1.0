NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# 仅服务端使用，用于用户名解析和双联系方式注册，禁止添加 NEXT_PUBLIC_ 前缀
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
OPENAI_API_KEY=your-openai-api-key
OPENAI_SMART_MODEL=gpt-5.4-nano
OPENAI_DEEP_MODEL=gpt-5.4-mini
OPENAI_ESCALATION_MODEL=gpt-5.6-luna
AI_SCREENING_DEEP_MAX_MODEL_CALLS_PER_CUSTOMER=1
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_BILLING_DATASET=
GOOGLE_CLOUD_SERVICE_ACCOUNT_JSON=
OPENAI_ADMIN_API_KEY=
# 按 Google Cloud 当前合同/阶梯价折算的单次参考价；最终金额仍需与 Cloud Billing 对账。
GOOGLE_PLACES_TEXT_SEARCH_USD_PER_REQUEST=
GOOGLE_PLACES_PRO_USD_PER_REQUEST=
GOOGLE_PLACES_ENTERPRISE_USD_PER_REQUEST=
GOOGLE_PLACES_ENTERPRISE_ATMOSPHERE_USD_PER_REQUEST=
GOOGLE_PLACES_MAX_PAID_DETAILS_PER_CUSTOMER=2
OPENAI_MAX_RESERVED_USD_PER_CALL=0.15
