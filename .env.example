NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
OPENAI_API_KEY=
# 智能分析：速度/成本优先；深度分析：复杂证据复核。均仅服务端使用。
OPENAI_SMART_MODEL=gpt-5.4-nano
OPENAI_DEEP_MODEL=gpt-5.4-mini
OPENAI_ESCALATION_MODEL=gpt-5.6-luna
AI_SCREENING_DEEP_MAX_MODEL_CALLS_PER_CUSTOMER=1
GOOGLE_MAPS_API_KEY=
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_BILLING_DATASET=
# Optional. Default is gcp_billing_export_resource_v1_* in the dataset above.
# Set this only when Google Cloud created a differently named detailed-usage table.
GOOGLE_CLOUD_BILLING_TABLE=
GOOGLE_CLOUD_SERVICE_ACCOUNT_JSON=
OPENAI_ADMIN_API_KEY=
# Google Cloud API 不在响应中返回本次扣费。以下填写控制台当前价目折算后的“每次请求美元价”，
# 留空时系统仍记录调用，但金额显示“单价待配置”，不会误报为免费。
GOOGLE_PLACES_TEXT_SEARCH_USD_PER_REQUEST=
GOOGLE_PLACES_PRO_USD_PER_REQUEST=
GOOGLE_PLACES_ENTERPRISE_USD_PER_REQUEST=
